{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mub-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "none"
  },
  "vars": {
    "LEGACY_VERCEL_ORIGIN": "https://mub-brown.vercel.app"
  }
}
